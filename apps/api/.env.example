# Copy to apps/api/.env (do not overwrite an existing file). Local-only values, no real secrets.
NODE_ENV=development
PORT=3001
# Local PostgreSQL from `pnpm db:start` or `docker compose up -d db` (port 5433). Test password, localhost only.
DATABASE_URL=postgresql://nexora:nexora@127.0.0.1:5433/nexora?schema=public
# Integration tests use a separate database. Its name must end with _test.
DATABASE_URL_TEST=postgresql://nexora:nexora@127.0.0.1:5433/nexora_test?schema=public
# Demo session lifetime (hours) and cookie Secure flag (true behind HTTPS).
SESSION_TTL_HOURS=168
COOKIE_SECURE=false
# Deterministic market simulator seed. Optional fixed clock (ISO-8601 UTC) for reproducible demos/tests.
MARKET_SEED=20261015
MARKET_FIXED_TIME=
