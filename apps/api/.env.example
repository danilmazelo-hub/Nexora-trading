# Copy to apps/api/.env (do not overwrite an existing file). Local-only values, no real secrets.
NODE_ENV=development
PORT=3001
# Local PostgreSQL from `pnpm db:start` or `docker compose up -d db` (port 5433). Test password, localhost only.
DATABASE_URL=postgresql://nexora:nexora@127.0.0.1:5433/nexora?schema=public
# Integration tests use a separate database. Its name must end with _test.
DATABASE_URL_TEST=postgresql://nexora:nexora@127.0.0.1:5433/nexora_test?schema=public
# Demo session lifetime (hours) and cookie Secure flag (true behind HTTPS).
SESSION_TTL_HOURS=168
COOKIE_SECURE=false
# Deterministic market simulator seed. Optional fixed clock (ISO-8601 UTC) for reproducible demos/tests.
MARKET_SEED=20261015
MARKET_FIXED_TIME=
# Live reference prices (ADR 0005, 0007), optional. Comma list: binance (crypto, no key), twelvedata (forex, stocks,
# gold; key), massive (indices EOD; key), eia (energy history + labelled simulator; key).
# Empty or "off" = demo simulator only. Live feeds are used only while the market clock runs in real time.
MARKET_LIVE_FEEDS=off
# Personal key from twelvedata.com. Put it only into apps/api/.env — never commit it.
TWELVEDATA_API_KEY=
# Markets served by Twelve Data (shared credit budget): forex, stocks (US), metals (XAU/XAG/XPT/XPD vs USD).
TWELVEDATA_MARKETS=forex,stocks,metals
# Plan limits (Basic: 8 per minute, 800 per day) and refresh period of the pair open on a chart, seconds.
TWELVEDATA_MINUTE_LIMIT=8
TWELVEDATA_DAILY_LIMIT=800
TWELVEDATA_FOCUS_REFRESH_SEC=60
# Indices end of day (Massive, activate "Indices Basic" in the Massive dashboard) and EIA energy history.
# Add massive / eia to MARKET_LIVE_FEEDS to use them. Keys only in apps/api/.env.
MASSIVE_API_KEY=
EIA_API_KEY=
