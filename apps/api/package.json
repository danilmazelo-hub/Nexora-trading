{
  "name": "@nexora/api",
  "version": "0.1.0",
  "private": true,
  "description": "NEXORA Trading demo backend (NestJS modular monolith)",
  "scripts": {
    "dev": "nest start --watch --preserveWatchOutput",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run -c vitest.int.config.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@nexora/contracts": "workspace:*",
    "@prisma/client": "6.19.3",
    "cookie-parser": "1.4.7",
    "decimal.js": "10.6.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.7",
    "@swc/core": "1.16.18",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/supertest": "7.2.1",
    "prisma": "6.19.3",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "unplugin-swc": "2.0.0",
    "vitest": "3.2.7"
  }
}
