# Copy to tools/.env and fill in. tools/.env is never included in the ZIP or sent to the browser.
TWELVEDATA_API_KEY=
# Optional CoinGecko Demo key (~10 000 calls/month). Bulk refresh interval in seconds (300 ≈ 8 600 calls/month)
COINGECKO_API_KEY=
COINGECKO_MIN_INTERVAL=300
# Free-plan limits (change if you buy a paid plan)
TWELVEDATA_RPM=8
TWELVEDATA_DAILY=800
